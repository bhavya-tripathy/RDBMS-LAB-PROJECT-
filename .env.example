# ==============================================================================
# Library Management System - Environment Variables Example
# Copy this file to .env in your root and/or server/ directory and fill in your MySQL credentials
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MySQL Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=library_management_system

# Illustrative academic fine rate in INR per overdue day (default: 5)
FINE_RATE_PER_DAY=5
